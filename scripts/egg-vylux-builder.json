{
  "_comment": "VYLUX AI Builder - Pterodactyl Egg",
  "meta": {
    "version": "1.0.0",
    "update_url": null
  },
  "exported_at": "2026-05-22T12:00:00Z",
  "name": "VYLUX AI Builder",
  "author": "VYLUXTECHINC",
  "description": "Builds the VYLUX AI Android binary (aarch64). Requires unlimited disk (60GB+) and 16GB+ RAM.",
  "features": [],
  "docker_images": {
    "Ubuntu 22.04": "ghcr.io/pterodactyl/yolks:ubuntu"
  },
  "file_denylist": [],
  "startup": "bash /home/container/build-vylux.sh",
  "config": {
    "files": "{}",
    "startup": "{\"done\":\"BUILD COMPLETE\"}",
    "logs": "{}",
    "stop": "exit"
  },
  "scripts": {
    "installation": {
      "script": "# VYLUX AI Builder Installation\nmkdir -p /home/container/output\necho 'Output directory ready'",
      "container": "ubuntu:22.04",
      "entrypoint": "bash"
    }
  },
  "variables": [
    {
      "name": "Git Branch",
      "description": "Branch of TERMUX-AI to build",
      "env_variable": "VYLUX_BRANCH",
      "default_value": "main",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:50"
    },
    {
      "name": "Serve After Build",
      "description": "Start a file server on port 8080 after build?",
      "env_variable": "VYLUX_SERVE",
      "default_value": "false",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|in:true,false"
    }
  ]
}
