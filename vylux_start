#!/usr/bin/env bash
set -euo pipefail

VYLUX_DIR="$(cd "$(dirname "$0")" && pwd)"
BINARY="$VYLUX_DIR/vylux"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${CYAN}"
echo "  ╔══════════════════════════════╗"
echo "  ║     VYLUX AI  Terminal       ║"
echo "  ║  made by VYLUX TECH          ║"
echo "  ╚══════════════════════════════╝"
echo -e "${NC}"

# Check for pre-built binary
if [ -f "$BINARY" ] && [ -x "$BINARY" ]; then
    echo -e "${GREEN}Starting VYLUX AI...${NC}"
    exec "$BINARY"
    exit 0
fi

# Check for Node.js
if ! command -v node &>/dev/null; then
    echo -e "${RED}Node.js is required.${NC}"
    echo "Install it in Termux:"
    echo "  pkg install nodejs"
    exit 1
fi

# Check for node CLI script
CLI_SCRIPT="$VYLUX_DIR/vylux-cli.js"
if [ ! -f "$CLI_SCRIPT" ]; then
    echo -e "${RED}Error: vylux-cli.js not found${NC}"
    exit 1
fi

echo -e "${GREEN}Launching VYLUX AI CLI (Node.js)...${NC}"
exec node "$CLI_SCRIPT"
